# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security Secret Keys
SECRET_KEY=synthetic_demo_jwt_secret_key_change_in_production_32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Database Connection (Neon Postgres)
DATABASE_URL=postgresql://user:password@ep-demo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# System Defaults
DEMO_MODE=true

# Batch 4 Preview Security (Must be 32+ chars)
VERCEL_ENV=preview
BATCH4_PREVIEW_ACCESS_KEY=batch4_synthetic_preview_key_987654321
VITE_BATCH4_ACCESS_KEY=batch4_synthetic_preview_key_987654321
